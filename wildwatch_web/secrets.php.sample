/**
 * Credentials template. Copy to secrets.php (which is git-ignored) and fill in real
 * values on each server / dev machine. config.php require_once's this file.
 */
define('DB_HOST', 'localhost');
define('DB_NAME', 'wildwatch_nestcheck');
define('DB_USER', 'wildwatch_nestcheck_api');
define('DB_PASS', 'CHANGE_ME_DB_PASSWORD');

// Read-only DB user for the admin SQL console. Create on the server with only SELECT:
//   CREATE USER 'wildwatch_ro'@'localhost' IDENTIFIED BY '...';
//   GRANT SELECT ON wildwatch_nestcheck.* TO 'wildwatch_ro'@'localhost';
define('DB_RO_USER', 'wildwatch_ro');
define('DB_RO_PASS', 'CHANGE_ME_RO_PASSWORD');

// Shared API key — read-only/cron access (write needs a Bearer token).
define('API_KEY', 'CHANGE_ME_API_KEY');
