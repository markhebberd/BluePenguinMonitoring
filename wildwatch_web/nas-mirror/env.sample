# Copy to /volume1/wildwatch/nas-mirror/.env (chmod 600). bootstrap-nas.sh writes this
# for you with random passwords — this file is just the shape of it.
WW_ROOT=/volume1/wildwatch

# Container Manager publishes this port on the NAS. Pick something DSM isn't using.
HTTP_PORT=8080
# Bind to the LAN address only, so the site can never be published by accident.
BIND_ADDR=192.168.1.109

DB_APP_PASS=CHANGE_ME_APP     # must match DB_PASS in shared/secrets.php
DB_RO_PASS=CHANGE_ME_RO       # must match DB_RO_PASS in shared/secrets.php
