<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PenguinMonitor.Pages.SettingsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">

            <!-- Version Info -->
            <Label Text="{Binding VersionText}"
                   HorizontalOptions="Center"
                   FontSize="14"
                   TextColor="#757575"/>

            <!-- Status Line -->
            <Label Text="{Binding StatusText}"
                   HorizontalOptions="Center"
                   FontSize="14"
                   TextColor="{Binding StatusColor}"/>

            <!-- Bluetooth Enable -->
            <Frame BackgroundColor="White"
                   BorderColor="#E0E0E0"
                   CornerRadius="12"
                   Padding="16"
                   HasShadow="False">
                <HorizontalStackLayout Spacing="10">
                    <CheckBox x:Name="BluetoothCheckBox"
                              IsChecked="{Binding AppSettings.IsBlueToothEnabled}"
                              CheckedChanged="OnBluetoothChanged"
                              VerticalOptions="Center"
                              Color="#2196F3"/>
                    <Label Text="Enable Bluetooth"
                           FontSize="15"
                           TextColor="#212121"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Frame>

            <!-- Set Time for Monitor -->
            <Frame BackgroundColor="White"
                   BorderColor="#E0E0E0"
                   CornerRadius="12"
                   Padding="16"
                   HasShadow="False">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="10">
                        <CheckBox IsChecked="{Binding AppSettings.ActiveSessionTimeStampActive}"
                                  VerticalOptions="Center"
                                  Color="#2196F3"/>
                        <Label Text="{Binding TimeStampText}"
                               FontSize="15"
                               TextColor="#212121"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <DatePicker x:Name="SessionDatePicker"
                                    Date="{Binding SessionDate}"
                                    Format="d MMM yyyy"
                                    TextColor="#212121"/>
                        <TimePicker x:Name="SessionTimePicker"
                                    Time="{Binding SessionTime}"
                                    Format="HH:mm"
                                    TextColor="#212121"
                                    Grid.Column="1"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Show Box Tag Delete Button -->
            <Frame BackgroundColor="White"
                   BorderColor="#E0E0E0"
                   CornerRadius="12"
                   Padding="16"
                   HasShadow="False">
                <HorizontalStackLayout Spacing="10">
                    <CheckBox IsChecked="{Binding AppSettings.ShowBoxTagDeleteButton}"
                              VerticalOptions="Center"
                              Color="#2196F3"/>
                    <Label Text="Show box tag delete button"
                           VerticalOptions="Center"
                           FontSize="15"
                           TextColor="#212121"/>
                </HorizontalStackLayout>
            </Frame>

            <!-- Show Differences with Previous Monitor -->
            <Frame BackgroundColor="White"
                   BorderColor="#E0E0E0"
                   CornerRadius="12"
                   Padding="16"
                   HasShadow="False">
                <HorizontalStackLayout Spacing="10">
                    <CheckBox IsChecked="{Binding AppSettings.ShowDifferencesWithPreviousMonitor}"
                              VerticalOptions="Center"
                              Color="#2196F3"/>
                    <Label Text="Show differences with previous monitor"
                           VerticalOptions="Center"
                           FontSize="15"
                           TextColor="#212121"/>
                </HorizontalStackLayout>
            </Frame>

            <!-- Box Sets Configuration -->
            <Frame BackgroundColor="White"
                   BorderColor="#E0E0E0"
                   CornerRadius="12"
                   Padding="16"
                   HasShadow="False">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Box sets:"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#212121"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Entry Text="{Binding AppSettings.AllBoxSetsString}"
                               Placeholder="{}{1-150,AA-AC},{N1-N6}..."
                               BackgroundColor="#F0F0F0"
                               TextColor="#212121"
                               PlaceholderColor="#757575"/>
                        <Button Text="Apply"
                                Command="{Binding ApplyBoxSetsCommand}"
                                BackgroundColor="#4CAF50"
                                TextColor="White"
                                CornerRadius="8"
                                Grid.Column="1"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Select Box Set -->
            <Frame BackgroundColor="White"
                   BorderColor="#E0E0E0"
                   CornerRadius="12"
                   Padding="16"
                   HasShadow="False">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Select box set(s):"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#212121"
                           HorizontalOptions="Center"/>
                    <Picker x:Name="BoxSetPicker"
                            ItemsSource="{Binding BoxSetOptions}"
                            SelectedItem="{Binding SelectedBoxSet}"
                            HorizontalOptions="FillAndExpand"
                            TextColor="#212121"
                            TitleColor="#757575"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
