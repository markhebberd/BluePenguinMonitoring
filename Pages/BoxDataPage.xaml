<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PenguinMonitor.Pages.BoxDataPage"
             Shell.NavBarIsVisible="False">

    <ScrollView x:Name="MainScrollView">
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Box Navigation -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Button Text="← Prev box"
                        Command="{Binding PrevBoxCommand}"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        IsEnabled="{Binding CanNavigatePrev}"
                        Opacity="{Binding PrevButtonOpacity}"
                        Grid.Column="0"/>

                <Button Text="Jump"
                        Command="{Binding SelectBoxCommand}"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        IsEnabled="{Binding IsLocked}"
                        Grid.Column="1"/>

                <Button Text="Next box →"
                        Command="{Binding NextBoxCommand}"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        IsEnabled="{Binding CanNavigateNext}"
                        Opacity="{Binding NextButtonOpacity}"
                        Grid.Column="2"/>
            </Grid>

            <!-- Historical Data Navigation - always visible when past data exists -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"
                  IsVisible="{Binding ShowHistoricalNavigation}">
                <Button Text="← Older"
                        Command="{Binding ViewOlderDataCommand}"
                        BackgroundColor="#9C27B0"
                        TextColor="White"
                        FontSize="12"
                        Padding="10,5"
                        IsEnabled="{Binding CanViewOlderData}"
                        Opacity="{Binding OlderButtonOpacity}"
                        Grid.Column="0"/>

                <Label Text="{Binding HistoricalDataLabel}"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#9C27B0"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Grid.Column="1"/>

                <Button Text="Newer →"
                        Command="{Binding ViewNewerDataCommand}"
                        BackgroundColor="#9C27B0"
                        TextColor="White"
                        FontSize="12"
                        Padding="10,5"
                        IsEnabled="{Binding CanViewNewerData}"
                        Opacity="{Binding NewerButtonOpacity}"
                        Grid.Column="2"/>
            </Grid>

            <!-- Box Title with Lock -->
            <Border StrokeThickness="2"
                    Stroke="#E0E0E0"
                    Background="White"
                    Padding="15"
                    StrokeShape="RoundRectangle 12">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleLockCommand}"/>
                        <SwipeGestureRecognizer Direction="Left" Command="{Binding ViewOlderDataCommand}"/>
                        <SwipeGestureRecognizer Direction="Right" Command="{Binding ViewNewerDataCommand}"/>
                    </Grid.GestureRecognizers>

                    <!-- Historical indicator (replaces expand/collapse) -->
                    <Label Text="{Binding HistoricalIndicator}"
                           FontSize="16"
                           TextColor="#9C27B0"
                           VerticalOptions="Center"
                           Padding="5"
                           Grid.Column="0"/>

                    <!-- Box Title -->
                    <Label Text="{Binding BoxTitle}"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{Binding TitleColor}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Grid.Column="1"/>

                    <!-- Lock Icon and Status -->
                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="0">
                        <Label Text="{Binding LockIcon}"
                               FontSize="24"
                               TextColor="{Binding LockColor}"
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding BoxStatusText}"
                               FontSize="9"
                               TextColor="{Binding LockColor}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- Data Saved Time -->
                    <Label Text="{Binding DataSavedTime}"
                           FontSize="11"
                           TextColor="{Binding TitleColor}"
                           HorizontalTextAlignment="End"
                           VerticalOptions="Center"
                           Grid.Column="3"
                           Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- Sticky Notes from Historical Data -->
            <Border StrokeThickness="1"
                    Stroke="#2196F3"
                    Background="#F0F0F0"
                    Padding="10"
                    StrokeShape="RoundRectangle 8"
                    IsVisible="{Binding HasStickyNotes}">
                <Label Text="{Binding StickyNotes}"
                       FontSize="14"
                       TextColor="#2196F3"
                       HorizontalTextAlignment="Center"/>
            </Border>

            <!-- Box Content (always visible) -->
            <VerticalStackLayout Spacing="15">

                <!-- Scanned Birds -->
                <Border StrokeThickness="1"
                        Stroke="#E0E0E0"
                        Background="#F5F5F5"
                        Padding="15"
                        StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding ScannedBirdsHeader}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#212121"/>

                        <CollectionView ItemsSource="{Binding ScannedBirds}"
                                        IsVisible="{Binding HasScans}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border StrokeThickness="0"
                                            Background="{Binding BackgroundColor}"
                                            Padding="8"
                                            Margin="0,2"
                                            StrokeShape="RoundRectangle 4">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <VerticalStackLayout Grid.Column="0">
                                                <HorizontalStackLayout Spacing="8">
                                                    <Label Text="{Binding BirdId}"
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           TextColor="#212121"/>
                                                    <Label Text="{Binding SexLabel}"
                                                           FontSize="12"
                                                           TextColor="#757575"/>
                                                    <Label Text="{Binding LifeStageLabel}"
                                                           FontSize="12"
                                                           TextColor="#757575"/>
                                                </HorizontalStackLayout>
                                                <Label Text="{Binding TimestampDisplay}"
                                                       FontSize="11"
                                                       TextColor="#757575"/>
                                            </VerticalStackLayout>

                                            <!-- Move Button -->
                                            <Button Text="↔"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.MoveScanCommand}"
                                                    CommandParameter="{Binding}"
                                                    BackgroundColor="#FF9800"
                                                    TextColor="White"
                                                    FontSize="14"
                                                    Padding="8,4"
                                                    WidthRequest="40"
                                                    HeightRequest="32"
                                                    IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CanEditScans}"
                                                    Grid.Column="1"
                                                    Margin="5,0"/>

                                            <!-- Delete Button -->
                                            <Button Text="✕"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteScanCommand}"
                                                    CommandParameter="{Binding}"
                                                    BackgroundColor="#F44336"
                                                    TextColor="White"
                                                    FontSize="14"
                                                    Padding="8,4"
                                                    WidthRequest="40"
                                                    HeightRequest="32"
                                                    IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CanEditScans}"
                                                    Grid.Column="2"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Label Text="{Binding NoScansMessage}"
                               IsVisible="{Binding HasNoScans}"
                               TextColor="#757575"
                               FontSize="14"/>

                        <!-- Manual Scan Entry -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,8,0,0"
                              IsVisible="{Binding CanEditScans}">
                            <Entry Text="{Binding ManualScanInput}"
                                   Placeholder="Enter 8-digit scan number"
                                   Keyboard="Text"
                                   MaxLength="8"
                                   BackgroundColor="White"
                                   Grid.Column="0"/>
                            <Button Text="Add"
                                    Command="{Binding AddManualScanCommand}"
                                    BackgroundColor="#4CAF50"
                                    TextColor="White"
                                    Padding="16,8"
                                    Grid.Column="1"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Count Fields with Headers -->
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="4" RowSpacing="8">
                    <!-- Headers -->
                    <Label Text="Adults" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" Grid.Row="0" Grid.Column="0"/>
                    <Label Text="Eggs" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" Grid.Row="0" Grid.Column="1"/>
                    <Label Text="Chicks" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" Grid.Row="0" Grid.Column="2"/>
                    <Label Text="Confidence" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" Grid.Row="0" Grid.Column="3"/>
                    <Label Text="Gate" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" Grid.Row="0" Grid.Column="4"/>

                    <!-- Input Fields -->
                    <Entry Text="{Binding Adults}"
                           Keyboard="Numeric"
                           HorizontalTextAlignment="Center"
                           BackgroundColor="#F0F0F0"
                           IsEnabled="{Binding CanEdit}"
                           Grid.Row="1" Grid.Column="0"/>

                    <Entry Text="{Binding Eggs}"
                           Keyboard="Numeric"
                           HorizontalTextAlignment="Center"
                           BackgroundColor="#F0F0F0"
                           IsEnabled="{Binding CanEdit}"
                           Grid.Row="1" Grid.Column="1"/>

                    <Entry Text="{Binding Chicks}"
                           Keyboard="Numeric"
                           HorizontalTextAlignment="Center"
                           BackgroundColor="#F0F0F0"
                           IsEnabled="{Binding CanEdit}"
                           Grid.Row="1" Grid.Column="2"/>

                    <Picker ItemsSource="{Binding BreedingChanceOptions}"
                            SelectedItem="{Binding BreedingChance}"
                            BackgroundColor="#F0F0F0"
                            IsEnabled="{Binding CanEdit}"
                            Grid.Row="1" Grid.Column="3"/>

                    <Picker ItemsSource="{Binding GateStatusOptions}"
                            SelectedItem="{Binding GateStatus}"
                            BackgroundColor="#F0F0F0"
                            IsEnabled="{Binding CanEdit}"
                            Grid.Row="1" Grid.Column="4"/>
                </Grid>

                <!-- Notes -->
                <Border StrokeThickness="1"
                        Stroke="#E0E0E0"
                        Background="White"
                        Padding="15"
                        StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Notes:"
                               FontSize="14"
                               FontAttributes="Bold"/>
                        <Editor Text="{Binding Notes}"
                                Placeholder="Enter notes about this box..."
                                HeightRequest="80"
                                BackgroundColor="#F5F5F5"
                                IsEnabled="{Binding CanEdit}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Action Button - Clear when locked with data, Cancel when unlocked -->
                <Button Text="{Binding ActionButtonText}"
                        Command="{Binding ActionButtonCommand}"
                        BackgroundColor="{Binding ActionButtonColor}"
                        TextColor="White"
                        IsVisible="{Binding ShowActionButton}"
                        Margin="0,10,0,0"/>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
