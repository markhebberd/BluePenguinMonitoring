{
    "dotnet.defaultSolution": "PenguinMonitor.sln",
    "omnisharp.useModernNet": true,
    "omnisharp.enableRoslynAnalyzers": true,
    "omnisharp.enableEditorConfigSupport": true,
    "terminal.integrated.env.linux": {
        "DOTNET_ROOT": "${env:HOME}/.dotnet",
        "ANDROID_HOME": "${env:HOME}/Android/Sdk",
        "PATH": "${env:HOME}/.dotnet:${env:HOME}/.dotnet/tools:${env:HOME}/Android/Sdk/platform-tools:${env:HOME}/Android/Sdk/cmdline-tools/latest/bin:${env:PATH}"
    },
    "files.exclude": {
        "**/bin": true,
        "**/obj": true
    },
    "dotnet.completion.showCompletionItemsFromUnimportedNamespaces": true
}
