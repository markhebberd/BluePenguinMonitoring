<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="secrets.props" Condition="Exists('secrets.props')" />

  <PropertyGroup>
    <TargetFrameworks>net9.0-android</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <NoWarn>$(NoWarn);CA1422</NoWarn>
    <Platforms>ARM64;x64;AnyCPU</Platforms>

    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>

    <!-- Display name -->
    <ApplicationTitle>Penguin Monitor</ApplicationTitle>
    <ApplicationId>PenguinMonitor</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>37.25</ApplicationDisplayVersion>

    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <PublishSingleFile>false</PublishSingleFile>
    <UseAppHost>false</UseAppHost>
    <TrimMode>full</TrimMode>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>

    <!-- Signing Deets-->
    <AndroidKeyStore>True</AndroidKeyStore>
    <AndroidSigningKeyStore>$(MSBuildThisFileDirectory)my-release-key.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>my-key-alias</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>$(KeystorePassword)</AndroidSigningStorePass>
    <AndroidSigningKeyPass>$(SigningKeyPassword)</AndroidSigningKeyPass>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidAot>false</AndroidAot>
    <AndroidLinkMode>None</AndroidLinkMode>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <AndroidEnableDebugging>true</AndroidEnableDebugging>
    <AndroidAttachDebugger>true</AndroidAttachDebugger>
    <AndroidSdbHostPort>10000</AndroidSdbHostPort>
    <AndroidSdbTargetPort>10000</AndroidSdbTargetPort>
    <Debuggable>true</Debuggable>
    <AndroidKeyStore>false</AndroidKeyStore>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\AppIcon\appicon.svg" Color="#FFFFFF" BaseSize="128,128" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Android -->
    <AndroidResource Include="Platforms\Android\Resources\**\*" />
  </ItemGroup>

  <ItemGroup>
    <None Remove=".gitattributes" />
    <None Remove=".gitignore" />
    <None Remove="LICENSE" />
    <None Remove="my-release-key.keystore" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.9" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
